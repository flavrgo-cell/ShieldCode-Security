# ==============================================================================
# ShieldCode & TechStore — Supabase PostgreSQL Live Database Environment Template
# Copy this file to `.env.local` and fill in your Supabase project credentials.
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Server-side Service Role Key (recommended for server API routes; keep strictly secret)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Public App Base URL (used in verification email links)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: HMAC key for blind-indexing Edahabia cards
# EDAHABIA_HMAC_KEY=replace-with-strong-random-secret
