{
  "manifest_version": 3,
  "name": "ShieldCode - مكافحة التصيد والاحتيال",
  "short_name": "ShieldCode",
  "version": "2.2.0",
  "description": "إضافة المتصفح لحماية الحسابات والمراسلات المالية من محاولات التصيد عبر مطابقة رمز مكافحة التصيد المعتمد.",
  "default_locale": "ar",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShieldCode Anti-Phishing Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
